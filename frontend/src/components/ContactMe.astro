---
import { Button } from '../components/ui/Button';
---

<section id="contact-me" class="relative flex min-h-screen w-full flex-col items-center justify-center overflow-x-hidden sm:mt-[20dvh]">
  <div class="container my-32 flex h-full w-full max-w-[80dvw] flex-col items-start justify-evenly">
    <h2 class="w-[90%] font-montserrat text-3xl font-semibold !leading-relaxed text-foreground/70 md:ml-16 md:text-5xl">
      <span class="inline-block rotate-180">
        <i class="ph-fill ph-quotes"></i>
      </span>
      <span
        >It’s easy to fix a machine when you know how it’s built and how it works. <br />
        But <span class="bg-gradient-to-r from-p3 to-p4 bg-clip-text text-transparent">people…</span> they’re much more difficult.</span
      >
      <i class="ph-fill ph-quotes"></i>
    </h2>

    <div
      onclick="window.location.href = 'mailto:aniruddhagawali05@gmail.com'"
      class="relative mt-20 h-[6.5dvh] w-full cursor-pointer overflow-hidden rounded-full bg-foreground text-background sm:h-[12dvh] md:h-[22dvh]"
    >
      <div class="marquee flex items-center justify-center gap-10 text-center">
        <span>So lets talk</span>
        <span class="yarndings-20-regular text-4xl lowercase sm:text-6xl md:-mt-4 md:text-9xl"> y </span>
        <span>So lets talk</span>
        <span class="yarndings-20-regular text-4xl lowercase sm:text-6xl md:-mt-4 md:text-9xl"> y </span>
        <span>So lets talk</span>
        <span class="yarndings-20-regular text-4xl lowercase sm:text-6xl md:-mt-4 md:text-9xl"> y </span>
        <span>So lets talk</span>
        <span class="yarndings-20-regular text-4xl lowercase sm:text-6xl md:-mt-4 md:text-9xl"> y </span>
        <span>So lets talk</span>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    display: flex;
    white-space: nowrap;
    font-family: 'BOONE Regular', sans-serif;
    border-radius: 1000px;
    text-transform: uppercase;
    animation: marquee 10s linear infinite;
    width: max-content;
    user-select: none;
    font-size: 8rem;
  }

  .marquee:hover {
    animation-play-state: paused;
  }

  @media screen and (max-width: 768px) {
    .marquee {
      font-size: 4rem;
    }
  }

  @media screen and (max-width: 640px) {
    .marquee {
      font-size: 2rem;
    }
  }

  @keyframes marquee {
    from {
      transform: translateX(0%);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
