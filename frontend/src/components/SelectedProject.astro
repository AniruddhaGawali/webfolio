---
import { Button } from './ui/Button';
---

<section id="selected-project" class="relative mt-[20dvh] flex min-h-screen w-full flex-col items-center justify-center overflow-hidden">
  <!-- Wrapper for Pinning Title Only -->
  <div id="selected-project-title-wrapper" class="flex w-full -translate-y-1/2 justify-center">
    <h2
      id="selected-project-title"
      class="flex flex-col items-center justify-center gap-8 font-boone text-5xl uppercase text-p2-foreground sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl"
    >
      <div class="flex items-center justify-center gap-6 sm:mr-60">
        <span class="yarndings-20-regular -mt-4 text-5xl sm:text-6xl md:text-7xl">W</span>
        <span>Selected</span>
      </div>
      <div class="flex items-center justify-center gap-6 sm:ml-60">
        <span>Project</span>
        <span class="yarndings-20-regular text-5xl sm:text-6xl md:text-7xl">W</span>
      </div>
    </h2>
  </div>

  <div class="relative flex min-h-screen w-full flex-col items-center justify-center">
    <div
      class="mr-auto mt-[10%] w-full rounded-lg border border-p2-foreground bg-white/30 p-8 text-foreground shadow-md backdrop-blur-md sm:ml-[10%] sm:w-2/3 md:w-1/3"
    >
      <h3 class="font-boone text-4xl uppercase">Carrer Canves</h3>
      <div class="mt-1 flex flex-wrap gap-4 text-background">
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Web App</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Next JS</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">MongoDB</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">React PDF</span>
      </div>
      <p class="mt-4 text-base">
        A portfolio-building platform where users can create and showcase their professional profiles. It allows users to highlight their skills,
        experiences, and projects, making it easier to attract job opportunities and network with industry professionals.
      </p>
      <div class="mt-4 flex items-center justify-start gap-4">
        <Button className="bg-p2-foreground text-background hover:bg-p4">
          <i class="ph ph-eye text-xl"></i> View
        </Button>
        <Button className="bg-p2-foreground text-background hover:bg-p4">
          <i class="ph ph-github-logo text-xl"></i>
        </Button>
      </div>
    </div>

    <div
      class="ml-auto mt-[10%] w-full rounded-lg border border-p2-foreground bg-white/30 p-8 text-foreground shadow-md backdrop-blur-md sm:mr-[10%] sm:w-2/3 md:w-1/3"
    >
      <h3 class="font-boone text-4xl uppercase">Exploding Kitten</h3>
      <div class="mt-1 flex flex-wrap gap-4 text-background">
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Web App</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Next JS</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">MongoDB</span>
      </div>
      <p class="mt-4 text-base">
        An engaging single-player card game inspired by the popular "Exploding Kittens" tabletop game. Players draw cards from a shuffled deck, aiming
        to avoid the Exploding Kitten card while utilizing various action cards to enhance gameplay. The game features user authentication, allowing
        players to register, log in, and track their performance on a leaderboard. It's built with a React frontend and a Go backend, with Redis
        employed for managing game state and user data. The application is deployed on Vercel, providing a seamless online gaming experience.
      </p>
      <div class="mt-4 flex items-center justify-start gap-4">
        <Button className="bg-p2-foreground text-background hover:bg-p4">
          <i class="ph ph-eye text-xl"></i> View
        </Button>
        <Button className="bg-p2-foreground text-background hover:bg-p4">
          <i class="ph ph-github-logo text-xl"></i>
        </Button>
      </div>
    </div>

    <div
      class="mr-auto mt-[10%] w-full rounded-lg border border-p2-foreground bg-white/30 p-8 text-foreground shadow-md backdrop-blur-md sm:ml-[10%] sm:w-2/3 md:w-1/3"
    >
      <h3 class="font-boone text-4xl uppercase">SpendWise</h3>
      <div class="mt-1 flex flex-wrap gap-4 text-background">
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Mobile App</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Flutter</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">MongoDB</span>
        <span class="rounded-full bg-p2-foreground px-4 py-1 text-xs">Express JS</span>
      </div>
      <p class="mt-4 text-base">
        A personal finance management tool that helps users track expenses, set budgets, and analyze spending patterns. The platform includes visual
        analytics, automated categorization, and insights to improve financial planning.
      </p>
      <div class="mt-4 flex items-center justify-start gap-4">
        <Button className="bg-p2-foreground text-background hover:bg-p4">
          <i class="ph ph-eye text-xl"></i> View
        </Button>
        <Button className="bg-p2-foreground text-background hover:bg-p4">
          <i class="ph ph-github-logo text-xl"></i>
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Pin only the h2 title, allowing images to scroll
  gsap.fromTo(
    '#selected-project-title-wrapper',
    {
      opacity: 1,
    },
    {
      opacity: 1,
      scrollTrigger: {
        trigger: '#selected-project',
        start: 'top center',
        end: 'bottom center',
        pin: '#selected-project-title-wrapper', // Pins only the title section
        toggleActions: 'restart none none none',
        pinSpacing: false,
      },
    }
  );
</script>
